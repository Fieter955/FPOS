# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./ipos.db

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=ipos-super-secret-key-change-in-production-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
APP_NAME=iPos 5.0
APP_VERSION=5.0.0

# ══════════════════════════════════════════════════════════════════════════════
# AI PROVIDERS — urutan: Gemini → Groq → OpenRouter (auto fallback)
# ══════════════════════════════════════════════════════════════════════════════

# 1. Google Gemini (PRIMARY)
#    → Daftar di: https://aistudio.google.com/app/apikey
#    → 100% gratis, model: gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq (FALLBACK 1) — kalau Gemini rate limit
#    → Daftar di: https://console.groq.com
#    → Gratis, model: llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# 3. OpenRouter (FALLBACK 2) — kalau Groq juga rate limit
#    → Daftar di: https://openrouter.ai/keys
#    → Auto-detect model gratis >70B, tanpa perlu update manual
#    → Bisa kosong — sistem akan detect model gratis tanpa API key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Email Backup ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=emailkamu@gmail.com
SMTP_PASS=your_app_password_here
BACKUP_EMAIL=emailtujuan@gmail.com
AUTO_BACKUP_HOUR=21
EMAIL_BACKUP_ENABLED=false


# ── Telegram Notifications ────────────────────────────────────────────────────
# Cara setup:
# 1. Chat ke @BotFather di Telegram → /newbot → ikuti instruksi → copy token
# 2. Tambahkan bot ke grup/channel kamu ATAU chat langsung dengan bot
# 3. Chat ke @userinfobot untuk dapat Chat ID kamu
# 4. Isi dua nilai di bawah ini

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Update System ─────────────────────────────────────────────────────────────
UPDATE_CHECK_URL=https://raw.githubusercontent.com/YOURUSERNAME/ipos-releases/main/version.json

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*
