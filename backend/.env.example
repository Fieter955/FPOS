# Salin file ini menjadi `.env` lalu isi nilainya. JANGAN commit `.env` ke git.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default). Untuk client beban berat, ganti ke PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ipos
DATABASE_URL=sqlite:///./ipos.db

# ── Security ──────────────────────────────────────────────────────────────────
# BIARKAN KOSONG. Sistem akan generate kunci unik per-instalasi ke file `secret.key`.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
APP_NAME=iPos 5.0

# Password awal akun vendor 'Fieter' saat instalasi baru (opsional).
VENDOR_BOOTSTRAP_PASSWORD=

# ── Network / Tailscale ───────────────────────────────────────────────────────
# FPOS mengaktifkan Tailscale Funnel port 8010 otomatis saat aplikasi dimulai.

# ── CORS ──────────────────────────────────────────────────────────────────────
# Pisahkan dengan koma. Contoh: https://namaclient.ts.net,http://localhost:8010
ALLOWED_ORIGINS=http://localhost:8010

# ── AI Providers (opsional) ───────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Email Backup (opsional) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
BACKUP_EMAIL=
EMAIL_BACKUP_ENABLED=false

# ── Google Drive Backup (opsional) ────────────────────────────────────────────
DRIVE_FOLDER_ID=
DRIVE_BACKUP_ENABLED=false
AUTO_BACKUP_HOUR=1

# ── Telegram Notifications (opsional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Update System ─────────────────────────────────────────────────────────────
UPDATE_CHECK_URL=https://raw.githubusercontent.com/Fieter955/FPOS/local-main-2026-08-20/version.json
UPDATE_ALLOW_HTTP=false

# Central lifetime license service. Normally configured from the local Fieter
# maintenance screen; these values provide deployment defaults.
LICENSE_SERVER_URL=
LICENSE_PUBLIC_KEY_B64=
LICENSE_OFFLINE_GRACE_HOURS=72
LICENSE_ALLOW_HTTP=false
